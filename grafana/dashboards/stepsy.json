import "date"

from(bucket: "steps")
  |> range(start: -90d)
  |> filter(fn: (r) => r._measurement == "steps")
  |> filter(fn: (r) => r._field == "count")
  |> map(fn: (r) => ({
      weekday: if date.weekDay(t: r._time) == 0 then "Sunday"
        else if date.weekDay(t: r._time) == 1 then "Monday"
        else if date.weekDay(t: r._time) == 2 then "Tuesday"
        else if date.weekDay(t: r._time) == 3 then "Wednesday"
        else if date.weekDay(t: r._time) == 4 then "Thursday"
        else if date.weekDay(t: r._time) == 5 then "Friday"
        else "Saturday",
      value: r._value
  }))
  |> group(columns: ["weekday"])
  |> mean(column: "value")
  |> group()
  |> keep(columns: ["weekday", "value"])
  |> sort(columns: ["weekday"])