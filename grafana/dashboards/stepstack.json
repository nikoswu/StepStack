      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Average Steps by Weekday",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "stepstack-influxdb"
                      },
                      "spec": {
                        "query": "import \"date\"\r\n\r\nfrom(bucket: \"steps\")\r\n  |> range(start: -90d)\r\n  |> filter(fn: (r) => r._measurement == \"steps\")\r\n  |> filter(fn: (r) => r._field == \"count\")\r\n  |> map(fn: (r) => ({\r\n      weekday: if date.weekDay(t: r._time) == 0 then \"Sunday\"\r\n        else if date.weekDay(t: r._time) == 1 then \"Monday\"\r\n        else if date.weekDay(t: r._time) == 2 then \"Tuesday\"\r\n        else if date.weekDay(t: r._time) == 3 then \"Wednesday\"\r\n        else if date.weekDay(t: r._time) == 4 then \"Thursday\"\r\n        else if date.weekDay(t: r._time) == 5 then \"Friday\"\r\n        else \"Saturday\",\r\n      value: r._value\r\n  }))\r\n  |> group(columns: [\"weekday\"])\r\n  |> mean(column: \"value\")\r\n  |> group()\r\n  |> keep(columns: [\"weekday\", \"value\"])\r\n  |> sort(columns: [\"weekday\"])"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
